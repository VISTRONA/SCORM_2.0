{
  "name": "hr-scorm-studio",
  "private": true,
  "version": "0.2.3",
  "type": "module",
  "description": "Local-first HR course authoring beta built on Scormly",
  "license": "MIT",
  "author": "Dmytro Matsiuk",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "predev": "node scripts/syncPlayerCss.mjs",
    "dev": "vite",
    "prebuild": "node scripts/syncPlayerCss.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:ai": "node --env-file-if-exists=.env --experimental-strip-types server/index.ts --dev",
    "start": "node --env-file-if-exists=.env --experimental-strip-types server/index.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "jszip": "^3.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
